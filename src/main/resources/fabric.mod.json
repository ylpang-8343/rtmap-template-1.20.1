{
	"schemaVersion": 1,
	"id": "rtmap",
	"version": "${version}",
	"name": "RTMap",
	"description": "A map mod for technical Minecraft players: slime chunks, portal linking, spawn ranges and chunk loading visualization.",
	"authors": [
		"CabbageNotDelicious"
	],
	"contact": {
		"homepage": "https://github.com/ylpang-8343",
		"sources": "https://github.com/ylpang-8343/rtmap-template-1.20.1"
	},
	"license": "CC0-1.0",
	"icon": "assets/rtmap/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cabbage.rtmap.RTMap"
		],
		"client": [
			"com.cabbage.rtmap.client.RTMapClient"
		],
		"fabric-datagen": [
			"com.cabbage.rtmap.RTMapDataGenerator"
		]
	},
	"mixins": [
		"rtmap.mixins.json",
		{
			"config": "rtmap.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}